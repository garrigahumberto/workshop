<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_location_list" model="ir.ui.view">
        <field name="name">workshop.location.list</field>
        <field name="model">workshop.location</field>
        <field name="arch" type="xml">
            <list string="Tiendas y talleres">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="location_type"/>
                <field name="stock_location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_location_form" model="ir.ui.view">
        <field name="name">workshop.location.form</field>
        <field name="model">workshop.location</field>
        <field name="arch" type="xml">
            <form string="Ubicación operativa">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="location_type"/>
                        <field name="stock_location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workshop_locations" model="ir.actions.act_window">
        <field name="name">Tiendas y talleres</field>
        <field name="res_model">workshop.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
