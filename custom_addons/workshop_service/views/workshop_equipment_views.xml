<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_equipment_list" model="ir.ui.view">
        <field name="name">workshop.equipment.list</field>
        <field name="model">workshop.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_equipment_form" model="ir.ui.view">
        <field name="name">workshop.equipment.form</field>
        <field name="model">workshop.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-wrench" invisible="not id">
                            <field name="order_count" widget="statinfo" string="Órdenes"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="equipment_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Observaciones e identificación adicional..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workshop_equipment_search" model="ir.ui.view">
        <field name="name">workshop.equipment.search</field>
        <field name="model">workshop.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="serial_number"/>
                <field name="brand"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Agrupar por cliente" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por tipo" name="group_type"
                        context="{'group_by': 'equipment_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_workshop_equipment" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">workshop.equipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
