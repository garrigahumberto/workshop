<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_repair_type_list" model="ir.ui.view">
        <field name="name">workshop.repair.type.list</field>
        <field name="model">workshop.repair.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de reparación">
                <field name="code"/>
                <field name="name"/>
                <field name="require_quote_acceptance"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_repair_type_form" model="ir.ui.view">
        <field name="name">workshop.repair.type.form</field>
        <field name="model">workshop.repair.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de reparación">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="require_quote_acceptance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Procedimientos sugeridos" name="procedures">
                            <field name="suggested_procedure_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workshop_repair_types" model="ir.actions.act_window">
        <field name="name">Tipos de reparación</field>
        <field name="res_model">workshop.repair.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
