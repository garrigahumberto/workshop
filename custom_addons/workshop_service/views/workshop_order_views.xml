<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_order_list" model="ir.ui.view">
        <field name="name">workshop.order.list</field>
        <field name="model">workshop.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de trabajo" decoration-danger="is_late" decoration-muted="state == 'cancelada'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="repair_type_id"/>
                <field name="user_id"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
                <field name="request_date"/>
                <field name="promised_date"/>
                <field name="is_late" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_order_form" model="ir.ui.view">
        <field name="name">workshop.order.form</field>
        <field name="model">workshop.order</field>
        <field name="arch" type="xml">
            <form string="Orden de trabajo">
                <header>
                    <button name="action_start_diagnosis" type="object" string="Iniciar diagnóstico"
                            class="btn-primary" invisible="state != 'solicitud'"
                            groups="workshop_service.group_workshop_technician,workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_send_quote" type="object" string="Pasar a presupuesto"
                            class="btn-primary" invisible="state != 'diagnostico'"
                            groups="workshop_service.group_workshop_technician,workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_approve" type="object" string="Registrar aprobación"
                            class="btn-primary" invisible="state != 'presupuesto'"
                            groups="workshop_service.group_workshop_salesperson,workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_start_repair" type="object" string="Iniciar reparación"
                            invisible="state not in ('presupuesto', 'aprobada')"
                            groups="workshop_service.group_workshop_technician,workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_finish" type="object" string="Terminar"
                            class="btn-primary" invisible="state != 'en_reparacion'"
                            groups="workshop_service.group_workshop_technician,workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_deliver" type="object" string="Entregar"
                            class="btn-primary" invisible="state != 'terminada'"
                            groups="workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_close" type="object" string="Cerrar"
                            class="btn-primary" invisible="state != 'entregada'"
                            groups="workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <button name="action_cancel" type="object" string="Cancelar orden"
                            invisible="state in ('entregada', 'cerrada', 'cancelada')"
                            confirm="¿Cancelar la orden? Se conservará su historial."
                            groups="workshop_service.group_workshop_supervisor,workshop_service.group_workshop_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="solicitud,diagnostico,presupuesto,aprobada,en_reparacion,terminada,entregada,cerrada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="equipment_id"/>
                            <field name="repair_type_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="request_date"/>
                            <field name="promised_date"/>
                            <field name="is_late" invisible="1"/>
                            <field name="follow_up_type"/>
                            <field name="original_order_id" invisible="not follow_up_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Solicitud" name="request">
                            <field name="description"/>
                        </page>
                        <page string="Diagnóstico" name="diagnosis">
                            <field name="diagnosis"/>
                        </page>
                        <page string="Presupuesto" name="quote">
                            <group>
                                <group string="Aceptación del presupuesto">
                                    <field name="accepted_by_name"/>
                                    <field name="acceptance_channel"/>
                                    <field name="acceptance_notes"/>
                                </group>
                                <group string="Registro">
                                    <field name="accepted_at"/>
                                    <field name="accepted_registered_by_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Procedimientos" name="procedures">
                            <field name="procedure_application_ids">
                                <list editable="bottom">
                                    <field name="procedure_version_id" options="{'no_create': True}"
                                           domain="[('state', '=', 'published')]"/>
                                    <field name="procedure_id"/>
                                    <field name="parent_application_id"/>
                                    <field name="applied_by"/>
                                    <field name="applied_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ejecución" name="execution">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-muted="state == 'not_applicable'"
                                      decoration-success="state == 'done'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_manual" column_invisible="True"/>
                                    <field name="line_type"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="product_id"/>
                                    <field name="planned_quantity" readonly="not is_manual"/>
                                    <field name="actual_quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_minutes" optional="hide"/>
                                    <field name="actual_minutes" optional="hide"/>
                                    <field name="valuation_method" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="applied_unit_price" optional="hide"/>
                                    <field name="not_applicable_reason" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_mark_done" type="object" icon="fa-check"
                                            title="Marcar como realizada" invisible="state == 'done'"/>
                                    <button name="action_mark_not_applicable" type="object" icon="fa-ban"
                                            title="Marcar como no aplicable (indique el motivo)"
                                            invisible="state == 'not_applicable'"/>
                                    <button name="action_mark_pending" type="object" icon="fa-undo"
                                            title="Volver a pendiente" invisible="state == 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Entrega" name="delivery">
                            <group>
                                <group>
                                    <field name="delivery_received_by"/>
                                </group>
                                <group>
                                    <field name="completed_at"/>
                                    <field name="delivered_at"/>
                                    <field name="delivered_by_id"/>
                                    <field name="closed_at"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notas internas" name="internal_notes">
                            <field name="internal_notes"/>
                        </page>
                        <page string="Cancelación" name="cancellation">
                            <field name="cancellation_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_workshop_order_search" model="ir.ui.view">
        <field name="name">workshop.order.search</field>
        <field name="model">workshop.order</field>
        <field name="arch" type="xml">
            <search string="Órdenes de trabajo">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <field name="repair_type_id"/>
                <filter string="Mis órdenes" name="my_orders" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Abiertas" name="open"
                        domain="[('state', 'not in', ['entregada', 'cerrada', 'cancelada'])]"/>
                <filter string="Atrasadas" name="late"
                        domain="[('promised_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ['entregada', 'cerrada', 'cancelada'])]"/>
                <filter string="Agrupar por estado" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Agrupar por cliente" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por técnico" name="group_user"
                        context="{'group_by': 'user_id'}"/>
                <filter string="Agrupar por tipo de reparación" name="group_type"
                        context="{'group_by': 'repair_type_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_workshop_orders" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">workshop.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workshop_order_search"/>
    </record>
</odoo>
