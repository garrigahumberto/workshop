<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_consumable_allocation_list" model="ir.ui.view">
        <field name="name">workshop.consumable.allocation.list</field>
        <field name="model">workshop.consumable.allocation</field>
        <field name="arch" type="xml">
            <list string="Asignaciones de gastables" create="0" edit="0" delete="0">
                <field name="allocation_date"/>
                <field name="workshop_location_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_consumable_allocation_form" model="ir.ui.view">
        <field name="name">workshop.consumable.allocation.form</field>
        <field name="model">workshop.consumable.allocation</field>
        <field name="arch" type="xml">
            <form string="Asignación de gastables">
                <sheet>
                    <group>
                        <field name="stock_move_id"/>
                        <field name="workshop_location_id"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="allocation_date"/>
                    </group>
                    <div class="text-muted">
                        La transferencia debe registrarse y validarse primero desde Inventario.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workshop_consumable_allocations" model="ir.actions.act_window">
        <field name="name">Asignaciones de gastables</field>
        <field name="res_model">workshop.consumable.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
