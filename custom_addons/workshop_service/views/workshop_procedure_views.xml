<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_procedure_list" model="ir.ui.view">
        <field name="name">workshop.procedure.list</field>
        <field name="model">workshop.procedure</field>
        <field name="arch" type="xml">
            <list string="Procedimientos">
                <field name="reference"/>
                <field name="name"/>
                <field name="code"/>
                <field name="revision"/>
                <field name="state"/>
                <field name="published_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_procedure_form" model="ir.ui.view">
        <field name="name">workshop.procedure.form</field>
        <field name="model">workshop.procedure</field>
        <field name="arch" type="xml">
            <form string="Procedimiento">
                <header>
                    <button name="action_publish" type="object" string="Publicar"
                            class="btn-primary"
                            groups="workshop_service.group_workshop_procedure_manager,workshop_service.group_workshop_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_create_revision" type="object"
                            string="Crear revisión" class="btn-secondary"
                            groups="workshop_service.group_workshop_procedure_manager,workshop_service.group_workshop_manager"
                            invisible="state != 'published'"/>
                    <button name="action_archive" type="object" string="Archivar"
                            groups="workshop_service.group_workshop_manager"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                        <h3><field name="reference"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="state != 'draft'"/>
                            <field name="revision"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="published_by_id"/>
                            <field name="published_at"/>
                            <field name="change_summary"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="description" readonly="state != 'draft'"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="line_type"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="optional"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workshop_procedures" model="ir.actions.act_window">
        <field name="name">Procedimientos</field>
        <field name="res_model">workshop.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
